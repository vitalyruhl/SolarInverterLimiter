{
  "homeassistant/sensor/sbt_collector_uptime/config": {
    "name": "SBT Collector Uptime",
    "unique_id": "sbt_collector_uptime",
    "default_entity_id": "sensor.sbt_collector_uptime",
    "state_topic": "SolarBatteryTelemetry/System-Info/ESP",
    "value_template": "{{ value_json.uptimeHuman }}",
    "entity_category": "diagnostic",
    "icon": "mdi:timer-outline",
    "json_attributes_topic": "SolarBatteryTelemetry/System-Info/ESP",
    "json_attributes": [
      "uptimeMs"
    ],
    "expire_after": 180
  },
  "homeassistant/sensor/solarlimiter_uptime_human/config": {
    "name": "SolarLimiter Uptime",
    "unique_id": "solarlimiter_uptime_human",
    "default_entity_id": "sensor.solarlimiter_uptime_human",
    "state_topic": "SolarLimiter/System-Info/ESP",
    "value_template": "{{ value_json.uptimeHuman if value_json is defined and value_json.uptimeHuman is defined and value_json.uptimeHuman is string and value_json.uptimeHuman | trim | length > 0 else 'unknown' }}",
    "availability_topic": "SolarLimiter/System-Info/status",
    "payload_available": "online",
    "payload_not_available": "offline",
    "icon": "mdi:timer-outline",
    "expire_after": 180
  },
  "homeassistant/sensor/solarlimiter_discharge_budget/config": {
    "name": "SolarLimiter Discharge Budget",
    "unique_id": "solarlimiter_discharge_budget",
    "default_entity_id": "sensor.solarlimiter_discharge_budget",
    "state_topic": "SolarLimiter/Planning/DischargeBudget",
    "value_template": "{{ 'ready' if value_json.valid | default(false) else 'invalid' }}",
    "json_attributes_topic": "SolarLimiter/Planning/DischargeBudget",
    "availability_topic": "SolarLimiter/System-Info/status",
    "payload_available": "online",
    "payload_not_available": "offline",
    "expire_after": 180,
    "icon": "mdi:battery-clock-outline"
  },
  "homeassistant/sensor/solarlimiter_charge_plan/config": {
    "name": "SolarLimiter Charge Plan",
    "unique_id": "solarlimiter_charge_plan",
    "default_entity_id": "sensor.solarlimiter_charge_plan",
    "state_topic": "SolarLimiter/Planning/ChargePlan",
    "value_template": "{{ 'ready' if value_json.valid | default(false) else 'invalid' }}",
    "json_attributes_topic": "SolarLimiter/Planning/ChargePlan",
    "json_attributes": [
      "v",
      "valid",
      "reason",
      "kind",
      "g",
      "r",
      "pv",
      "t",
      "d",
      "n",
      "target",
      "unmetWh",
      "w",
      "s"
    ],
    "availability_topic": "SolarLimiter/System-Info/status",
    "payload_available": "online",
    "payload_not_available": "offline",
    "expire_after": 180
  },
  "homeassistant/sensor/sil_configured_maximum_output/config": {
    "name": "SIL configured maximum output",
    "unique_id": "sil_configured_maximum_output",
    "default_entity_id": "sensor.sil_configured_maximum_output",
    "state_topic": "SolarLimiter/Planning/Config",
    "value_template": "{%- set p = value_json | default({}, true) -%}\n{%- set w = p.maxOutputW | default(none) -%}\n{{- w if p is mapping and p.v | default(none) == 1\n    and p.valid | default(false) is sameas true\n    and w is number and w is not boolean\n    and 0 <= w <= 2147483647 and w % 1 == 0 else none -}}",
    "unit_of_measurement": "W",
    "device_class": "power",
    "entity_category": "diagnostic",
    "suggested_display_precision": 0,
    "icon": "mdi:tune-vertical",
    "json_attributes_topic": "SolarLimiter/Planning/Config",
    "availability_topic": "SolarLimiter/System-Info/status",
    "payload_available": "online",
    "payload_not_available": "offline",
    "expire_after": 180
  },
